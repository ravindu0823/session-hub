<Window x:Class="SessionHub.Tray.MainWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SessionHub.Tray.Controls"
        xmlns:t="clr-namespace:SessionHub.Tray"
        Title="Session Hub" Width="1000" Height="620" MinWidth="720" MinHeight="480"
        WindowStartupLocation="Manual" ResizeMode="CanResize" ShowInTaskbar="True"
        Icon="pack://application:,,,/app.ico"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Design 2 of the spec (§3.4, §9). DataContext: WindowViewModel. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root" Background="{DynamicResource PanelBackground}">
        <Border Background="{DynamicResource PanelGlow}" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="26" />
            </Grid.RowDefinitions>

            <!-- Title bar: tile, name, link pill, total waiting; caption buttons. -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center" ClipToBounds="True">
                        <Border Width="22" Height="22" CornerRadius="6" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF8A63" />
                                    <GradientStop Offset="1" Color="#E0501F" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <c:Glyph Data="{StaticResource Icon.Terminal}" Size="12" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Session Hub" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <c:Pill Style="{StaticResource LinkPill}" DataContext="{Binding Panel}" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource LinkDot}" Margin="0,0,7,0" />
                                <TextBlock Text="{Binding LinkText}" FontSize="12" FontWeight="Medium" />
                            </StackPanel>
                        </c:Pill>
                        <c:Pill Background="{DynamicResource AmberSoft}" Padding="9,1" VerticalAlignment="Center"
                                Visibility="{Binding WaitingChip, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding WaitingChip}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" />
                        </c:Pill>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                            <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="Maximize" AutomationProperties.Name="Maximize"
                                x:Name="MaxButton">
                            <Grid>
                                <Rectangle x:Name="MaxGlyph" Width="10" Height="10" StrokeThickness="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Path x:Name="RestoreGlyph" Width="10" Height="10" StrokeThickness="1" Visibility="Collapsed"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M 0.5 2.5 H 7.5 V 9.5 H 0.5 Z M 2.5 2.5 V 0.5 H 9.5 V 7.5 H 7.5" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseWindow" ToolTip="Close" AutomationProperties.Name="Close">
                            <c:Glyph Data="{StaticResource Icon.X}" Size="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Banner: daemon stopped (Start daemon) or link lost. -->
            <Border Grid.Row="1" Style="{StaticResource LinkBanner}" DataContext="{Binding Panel}" Margin="12,8,12,0"
                    Visibility="{Binding ShowBanner, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:Glyph Data="{StaticResource Icon.CircleAlert}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource Text2}" />
                    <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Style="{StaticResource SmallPrimaryButton}" Margin="8,0,0,0" Content="Start daemon"
                            Visibility="{Binding CanStartDaemon, Converter={StaticResource Visible}}" Click="OnStartDaemon" />
                </Grid>
            </Border>

            <!-- Body: session list and detail. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ListColumn" Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: search and the grouped list. -->
                <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource Line}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Margin="12" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                                Background="{DynamicResource Glass}" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <c:Glyph Data="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="ListSearchHint" Grid.Column="1" Text="Search" Foreground="{DynamicResource Muted}"
                                           VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBox x:Name="ListSearch" Grid.Column="1" Style="{StaticResource BareTextBox}" Padding="0,9"
                                         AutomationProperties.Name="Search sessions" MaxLength="200"
                                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnListSearchChanged"
                                         PreviewKeyDown="OnListSearchKey" />
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
                                            <Button Command="t:WindowCommands.ToggleGroup" CommandParameter="{Binding}" Focusable="{Binding Collapsible}"
                                                    Foreground="{DynamicResource Muted}" AutomationProperties.Name="{Binding Header}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="14,6,14,4">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <StackPanel Orientation="Horizontal">
                                                    <c:Glyph x:Name="Chevron" Size="12" Margin="0,0,4,0" VerticalAlignment="Center"
                                                             Data="{StaticResource Icon.ChevronRight}" Visibility="Collapsed" />
                                                    <TextBlock Text="{Binding Header, Converter={StaticResource Upper}}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                                          Visibility="{Binding ShowItems, Converter={StaticResource Visible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="t:WindowCommands.Select" CommandParameter="{Binding}" Cursor="Hand"
                                                                Foreground="{DynamicResource Text}" AutomationProperties.Name="{Binding Session.Name}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="row" Background="Transparent" BorderThickness="3,0,0,0" BorderBrush="Transparent"
                                                                            Padding="9,9,12,9">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource GlassHover}" />
                                                                        </Trigger>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource Same}">
                                                                                    <Binding />
                                                                                    <Binding Path="DataContext.Selected" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}" />
                                                                            <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                                                                        </DataTrigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Style="{StaticResource StateDot}" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Session.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding ListSubText}" FontSize="12" Foreground="{DynamicResource Muted}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Visibility="{Binding DataContext.ShowSubtitles, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                                                                </StackPanel>
                                                                <!-- The visibility sits on a wrapper: a ContentPresenter takes its content as DataContext. -->
                                                                <Border Grid.Column="2" Margin="8,0,-6,0" VerticalAlignment="Center"
                                                                        Visibility="{Binding ListBadge, Converter={StaticResource EmptyToCollapsed}}">
                                                                    <ContentPresenter Content="{Binding ListBadge}" ContentTemplate="{StaticResource ChipTemplate}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Collapsible}" Value="True">
                                                <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Icon.ChevronDown}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Right: header, tabs, tab content. DataContext of the parts: the selected card. -->
                <Grid Grid.Column="1" x:Name="Detail">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="16,12"
                            Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Style="{StaticResource StateDot}" DataContext="{Binding Selected}" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Session.Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding HeaderSub}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource OutlineButton}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    Command="t:PanelCommands.Jump" CommandParameter="{Binding Selected}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Terminal}" Size="15" Margin="0,0,7,0" />
                                    <TextBlock Text="Jump to terminal" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="16,0"
                            Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabStatus" Style="{StaticResource UnderlineTab}" GroupName="wtabs" Tag="Status" Checked="OnTab"
                                         AutomationProperties.Name="Status">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Info}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Status" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabHistory" Style="{StaticResource UnderlineTab}" GroupName="wtabs" Tag="History" Checked="OnTab"
                                         AutomationProperties.Name="History">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.ScrollText}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="History" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabSend" Style="{StaticResource UnderlineTab}" GroupName="wtabs" Tag="Send" Checked="OnTab"
                                         AutomationProperties.Name="Send">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Send}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Send" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}">
                        <!-- Status: progress and remaining | waiting on you, then the last exchange. -->
                        <ScrollViewer x:Name="StatusPane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,14,16,14" DataContext="{Binding Selected}" Focusable="False">
                            <StackPanel>
                                <Grid x:Name="StatusGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition x:Name="StatusGap" Width="14" />
                                        <ColumnDefinition x:Name="StatusRight" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition x:Name="StatusStackGap" Height="0" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Style="{StaticResource StatusBox}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="PROGRESS" />
                                            <Grid Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center">
                                                    <ProgressBar.Template>
                                                        <ControlTemplate TargetType="ProgressBar">
                                                            <Grid>
                                                                <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Surface2}" />
                                                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Offset="0" Color="#E0501F" />
                                                                            <GradientStop Offset="1" Color="#FF8A63" />
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </ProgressBar.Template>
                                                </ProgressBar>
                                                <TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" Text="{Binding ProgressLabel}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Text="{Binding PhaseText}" />
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT'S REMAINING" />
                                            <ItemsControl ItemsSource="{Binding RemainingLines}" Visibility="{Binding HasRemaining, Converter={StaticResource Visible}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="Nothing." Visibility="{Binding HasRemaining, Converter={StaticResource Hidden}}" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="WaitingBox" Grid.Column="2" Style="{StaticResource WaitingBox}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="WAITING ON YOU" />
                                            <ItemsControl ItemsSource="{Binding Answers.Items}" ItemTemplate="{StaticResource WaitingItemTemplate}"
                                                          Visibility="{Binding HasWaiting, Converter={StaticResource Visible}}" />
                                            <TextBlock Text="Nothing." Visibility="{Binding HasWaiting, Converter={StaticResource Hidden}}" />
                                            <StackPanel Visibility="{Binding Session.NeedsApproval, Converter={StaticResource Visible}}">
                                                <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                                                           Text="A permission prompt is open in its terminal. Approve it there." />
                                                <Button Style="{StaticResource SmallPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                                        Command="t:PanelCommands.Jump" CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <c:Glyph Data="{StaticResource Icon.ShieldCheck}" Size="15" Margin="0,0,7,0" />
                                                        <TextBlock Text="Jump to approve" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource StatusBox}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="LAST EXCHANGE" />
                                        <ItemsControl ItemsSource="{Binding LastExchange}" ItemTemplate="{StaticResource WideExchangeTemplate}"
                                                      Visibility="{Binding HasExchange, Converter={StaticResource Visible}}" />
                                        <TextBlock Text="No messages yet." Foreground="{DynamicResource Text2}"
                                                   Visibility="{Binding HasExchange, Converter={StaticResource Hidden}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <c:HistoryView x:Name="HistoryPane" Visibility="Collapsed" />

                        <!-- Send: reply box, live send state, info-only note. -->
                        <ScrollViewer x:Name="SendPane" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Padding="16,14" DataContext="{Binding Selected}" Visibility="Collapsed" Focusable="False">
                            <StackPanel>
                                <c:AnswerForm x:Name="WindowAnswerForm" Visibility="{Binding Answers.IsActive, Converter={StaticResource Visible}}" />
                                <StackPanel Visibility="{Binding Session.IsLive, Converter={StaticResource Visible}}">
                                    <c:SendBox x:Name="WindowSendBox" Visibility="{Binding Answers.IsActive, Converter={StaticResource Hidden}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                           Visibility="{Binding Session.IsLive, Converter={StaticResource Visible}}">
                                    <Run Text="Info-only message through the relay. If" /> <Run Text="{Binding Session.Name, Mode=OneWay}" /> <Run Text="is busy it stays pending until the session takes it into its turn (up to 30 min, then expired). Approvals still happen in its own terminal." />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Note}" Text="This session has ended. Messages can only go to live sessions."
                                           Visibility="{Binding Session.IsLive, Converter={StaticResource Hidden}}" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Short notice (Jump failed, daemon did not start). -->
                        <Border x:Name="Notice" VerticalAlignment="Bottom" Margin="16,0,16,12" CornerRadius="12" Padding="12,10"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!-- No session at all. -->
                    <Grid Grid.RowSpan="3" VerticalAlignment="Top" Margin="16,16,16,0"
                          Visibility="{Binding HasSelection, Converter={StaticResource Hidden}}">
                        <Rectangle RadiusX="14" RadiusY="14" Fill="{DynamicResource Glass}" Stroke="{DynamicResource LineStrong}"
                                   StrokeThickness="1" StrokeDashArray="4 3" />
                        <StackPanel HorizontalAlignment="Center" Margin="24,36">
                            <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource GreenSoft}" HorizontalAlignment="Center">
                                <c:Glyph Data="{StaticResource Icon.CircleCheck}" Size="24" Foreground="{DynamicResource Green}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="No sessions" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,6" />
                            <TextBlock Text="Start a Claude Code session and it shows up here." Foreground="{DynamicResource Text2}"
                                       TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Status bar. -->
            <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Style="{StaticResource LinkDot}" DataContext="{Binding Panel}" Width="7" Height="7" Margin="0,0,7,0" />
                    <!-- "live · last update 20 s ago", then a red warning when relay messages reached the wrong session. -->
                    <TextBlock Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text="{Binding StrayText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Red}" /></TextBlock>
                    <TextBlock Grid.Column="2" Text="Ctrl+1–3 tabs · Ctrl+F search" FontSize="11.5" Foreground="{DynamicResource Muted}"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
