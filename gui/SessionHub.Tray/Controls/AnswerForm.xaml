<UserControl x:Class="SessionHub.Tray.Controls.AnswerForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SessionHub.Tray.Controls"
             xmlns:t="clr-namespace:SessionHub.Tray"
             x:Name="Root">
    <!--
        DataContext: CardViewModel. One card per "Waiting on you" item with its answer box, the free
        message box, the footer (count, Clear, Send), the preview (window only) and the send state.
        Ctrl+Enter sends from any box; Enter is a new line (handled in code).
    -->
    <UserControl.Resources>
        <!-- An answer or message field: surface, line edge, accent edge while the caret is in it. -->
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A question card: glass, line edge; amber edge once its box has text. -->
        <Style x:Key="QuestionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Glass}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="{Binding CardPadding, ElementName=Root}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AmberEdge}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel PreviewKeyDown="OnPreviewKeyDown">
        <!-- Header: "WAITING ON YOU" and the count chip. -->
        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
            <c:Glyph Data="{StaticResource Icon.Inbox}" Size="14" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,7,0" />
            <TextBlock Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center" Text="WAITING ON YOU" />
            <c:Pill Margin="8,0,0,0" Padding="9,1" Background="{DynamicResource AmberSoft}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Answers.Total}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Amber}" />
            </c:Pill>
        </StackPanel>

        <ItemsControl x:Name="Questions" ItemsSource="{Binding Answers.Items}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource QuestionCard}">
                        <StackPanel>
                            <!-- Label, the tag of an answered or dismissed item, the text; Dismiss or Undo on the right. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{Binding LabelMinWidth, ElementName=Root}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" FontWeight="Bold" Margin="0,0,10,0" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNoId}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <InlineUIContainer BaselineAlignment="Center"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StateTagTemplate}" Margin="0,0,6,0" Visibility="{Binding TagText, Converter={StaticResource EmptyToCollapsed}}" /></InlineUIContainer><Run Text="{Binding Text, Mode=OneWay}" />
                                </TextBlock>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,0,0,0">
                                    <Button Style="{StaticResource QuietLinkButton}" Content="Dismiss" Click="OnDismiss"
                                            ToolTip="Answered somewhere Session Hub can't see? Dismiss it so it stops counting as waiting on you."
                                            AutomationProperties.Name="{Binding Label, StringFormat='Dismiss {0}'}"
                                            Visibility="{Binding CanDismiss, Converter={StaticResource Visible}}" />
                                    <Button Style="{StaticResource SmallLinkButton}" Content="Undo" Click="OnUndo"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Undo dismiss of {0}'}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" />
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Children}" Margin="{Binding ChildMargin, ElementName=Root}" Focusable="False"
                                          Visibility="{Binding HasChildren, Converter={StaticResource Visible}}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{DynamicResource Text2}" Margin="0,2,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- The answer box, with this item's own Send at its bottom right. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FieldBorder}" MinHeight="{Binding AnswerMinHeight, ElementName=Root}">
                                <Grid>
                                    <TextBlock Text="{Binding Placeholder}" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False" VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Answer}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                             MaxHeight="104" VerticalScrollBarVisibility="Auto" MaxLength="20000"
                                             AutomationProperties.Name="{Binding Placeholder}"
                                             Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                            </Border>
                            <Button Grid.Column="1" Style="{StaticResource TinyPrimaryButton}" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Command="t:PanelCommands.SendItem" CommandParameter="{Binding}"
                                    ToolTip="Send only this answer" ToolTipService.ShowOnDisabled="False"
                                    AutomationProperties.Name="{Binding Label, StringFormat='Send the answer to {0}'}">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Send}" Size="13" Margin="0,0,5,0" />
                                    <TextBlock Text="Send" />
                                </StackPanel>
                            </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The free message: the session's reply draft. -->
        <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14"
                Padding="{Binding CardPadding, ElementName=Root}" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    <c:Glyph Data="{StaticResource Icon.Send}" Size="13" Foreground="{DynamicResource Muted}" Margin="0,0,6,-2" />
                    <Run Text="MESSAGE" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
                    <Run Text=" (optional — anything else for this session)" FontSize="11.5" Foreground="{DynamicResource Muted}" />
                </TextBlock>
                <Border Style="{StaticResource FieldBorder}" Margin="0,6,0,0" MinHeight="64">
                    <Grid>
                        <TextBlock Text="Type a custom message…" Foreground="{DynamicResource Muted}" IsHitTestVisible="False" VerticalAlignment="Top">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Session.Draft}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="Message" Style="{StaticResource BareTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxHeight="162" VerticalScrollBarVisibility="Auto" MaxLength="20000"
                                 AutomationProperties.Name="Message"
                                 Text="{Binding Session.Draft, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Footer: what is filled, Clear, Send. Wraps to two lines when narrow. -->
        <DockPanel Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Click="OnClear" Content="Clear"
                        AutomationProperties.Name="Clear answers and message" />
                <Button Style="{StaticResource SmallPrimaryButton}" MinHeight="38"
                        Command="t:PanelCommands.Send" CommandParameter="{Binding}">
                    <StackPanel Orientation="Horizontal">
                        <c:Glyph Data="{StaticResource Icon.Send}" Size="15" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding Answers.SendLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Text="{Binding Answers.FooterText}" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
        </DockPanel>
        <TextBlock Text="{Binding Answers.TooLongText}" FontSize="12.5" Foreground="{DynamicResource Red}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding Answers.IsTooLong, Converter={StaticResource Visible}}" />

        <!-- What the session will receive (window only). -->
        <Border x:Name="PreviewHost">
        <Border x:Name="Preview" Margin="0,12,0,0" CornerRadius="12" Padding="12,10" BorderThickness="1"
                Visibility="{Binding Answers.HasPreview, Converter={StaticResource Visible}}">
            <Border.BorderBrush>
                <VisualBrush TileMode="None" Stretch="None">
                    <VisualBrush.Visual>
                        <Rectangle StrokeDashArray="4 3" Stroke="{DynamicResource LineStrong}" StrokeThickness="1" RadiusX="12" RadiusY="12"
                                   Width="{Binding ActualWidth, ElementName=Preview}" Height="{Binding ActualHeight, ElementName=Preview}" />
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.BorderBrush>
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabel}" Margin="0" Text="WHAT THE SESSION WILL RECEIVE" />
                <TextBlock Text="{Binding Answers.PreviewText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12.5"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Text2}" />
            </StackPanel>
        </Border>
        </Border>

        <c:SendStateLine Margin="2,10,0,0" TextMaxWidth="{Binding StateMaxWidth, ElementName=Root}" />
    </StackPanel>
</UserControl>
