<UserControl x:Class="SessionHub.Tray.Controls.SessionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SessionHub.Tray.Controls"
             xmlns:t="clr-namespace:SessionHub.Tray">
    <!-- DataContext: CardViewModel. The header toggles the body; the body holds status, the last exchange, the reply box and actions. -->
    <Grid>
    <Border Style="{StaticResource CardFrame}">
        <StackPanel>
            <Button Command="t:PanelCommands.Toggle" CommandParameter="{Binding}" Cursor="Hand" Foreground="{DynamicResource Text}"
                    AutomationProperties.Name="{Binding Session.Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Top" Margin="0,0,10,0"
                            Background="{Binding AvatarColor, Converter={StaticResource Hex}}">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Session.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       MaxWidth="250" />
                            <Ellipse Style="{StaticResource StateDot}" Margin="7,1,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding SubText}" FontSize="12" Foreground="{DynamicResource Muted}"
                                   TextTrimming="CharacterEllipsis" />
                        <WrapPanel Margin="0,4,0,0">
                            <ContentPresenter Content="{Binding ProfileChip}" ContentTemplate="{StaticResource ChipTemplate}" />
                            <ContentPresenter Content="{Binding StatusChip}" ContentTemplate="{StaticResource ChipTemplate}" />
                            <c:Pill Style="{StaticResource ChipBorder}" Visibility="{Binding IsUnknown, Converter={StaticResource Visible}}">
                                <TextBlock Text="unknown" Style="{StaticResource ChipText}" />
                            </c:Pill>
                        </WrapPanel>
                    </StackPanel>
                    <c:Glyph Grid.Column="2" Data="{StaticResource Icon.ChevronDown}" Size="16"
                             Foreground="{DynamicResource Muted}" VerticalAlignment="Top" Margin="6,4,0,0"
                             RenderTransformOrigin="0.5,0.5">
                        <c:Glyph.Style>
                            <Style TargetType="c:Glyph">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Session.IsExpanded}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="180" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:Glyph.Style>
                    </c:Glyph>
                </Grid>
            </Button>

            <StackPanel Visibility="{Binding Session.IsExpanded, Converter={StaticResource Visible}}">
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,10,0,0" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="PROGRESS" />
                <Grid Visibility="{Binding HasProgress, Converter={StaticResource Visible}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                 VerticalAlignment="Center">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid>
                                    <Border x:Name="PART_Track" CornerRadius="3" Background="{DynamicResource Surface2}" />
                                    <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#E0501F" />
                                                <GradientStop Offset="1" Color="#FF8A63" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontWeight="Bold" Text="{Binding ProgressLabel}" />
                </Grid>
                <TextBlock Style="{StaticResource Note}" Margin="0,4,0,0" Text="{Binding PhaseText}" />

                <TextBlock Style="{StaticResource SectionLabel}" Text="WHAT'S REMAINING" />
                <ItemsControl ItemsSource="{Binding RemainingLines}" Visibility="{Binding HasRemaining, Converter={StaticResource Visible}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Nothing." Visibility="{Binding HasRemaining, Converter={StaticResource Hidden}}" />

                <!-- With the answer form on (live, items waiting), its question cards and boxes replace this list and the reply box. -->
                <c:AnswerForm Compact="True" Margin="0,12,0,0" Visibility="{Binding Answers.IsActive, Converter={StaticResource Visible}}" />
                <StackPanel Visibility="{Binding Answers.IsActive, Converter={StaticResource Hidden}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="WAITING ON YOU" />
                    <ItemsControl ItemsSource="{Binding Answers.Items}" ItemTemplate="{StaticResource WaitingItemTemplate}"
                                  Visibility="{Binding HasWaiting, Converter={StaticResource Visible}}" />
                    <TextBlock Text="Nothing." Visibility="{Binding HasWaiting, Converter={StaticResource Hidden}}" />
                </StackPanel>

                <StackPanel Visibility="{Binding HasExchange, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="LAST EXCHANGE" />
                    <ItemsControl ItemsSource="{Binding LastExchange}" ItemTemplate="{StaticResource ExchangeTemplate}" />
                </StackPanel>

                <StackPanel Visibility="{Binding Answers.IsActive, Converter={StaticResource Hidden}}">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="REPLY" />
                    <c:SendBox />
                </StackPanel>

                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                            Command="t:PanelCommands.Jump" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource Icon.Terminal}" Size="15" Margin="0,0,7,0" />
                            <TextBlock Text="Jump to terminal" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource OutlineButton}"
                            Command="t:PanelCommands.OpenInWindow" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource Icon.Monitor}" Size="15" Margin="0,0,7,0" />
                            <TextBlock Text="Open in window" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </Border>
    <!-- Flashes for 1.6 s when a snapshot brings news for this session (spec §9 motion). -->
    <Border x:Name="Flash" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource AccentFill}" Margin="0,0,0,10"
            Opacity="0" IsHitTestVisible="False" />
    </Grid>
</UserControl>
