<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:SessionHub.Tray.Controls"
                    xmlns:t="clr-namespace:SessionHub.Tray">
    <!-- Controls in the kv tray design system (spec §9). Every colour is a DynamicResource from Themes/*.xaml. -->

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <c:InverseVisibility x:Key="Hidden" />
    <c:HexBrush x:Key="Hex" />
    <c:EmptyToCollapsed x:Key="EmptyToCollapsed" />
    <c:UpperText x:Key="Upper" />
    <c:SameObject x:Key="Same" />
    <c:Fraction x:Key="Fraction" />

    <!-- Section label: 11.5 px caps, muted. -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Margin" Value="0,12,0,4" />
    </Style>

    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Soft-tone pill. DataContext is a Chip; grey is surface-2 with a line. Triggers keep the theme live. -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Teal">
                <Setter Property="Background" Value="{DynamicResource TealSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Violet">
                <Setter Property="Background" Value="{DynamicResource VioletSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Amber">
                <Setter Property="Background" Value="{DynamicResource AmberSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Accent">
                <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Red">
                <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Green">
                <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tone}" Value="Teal">
                <Setter Property="Foreground" Value="{DynamicResource Teal}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Violet">
                <Setter Property="Foreground" Value="{DynamicResource Violet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Amber">
                <Setter Property="Foreground" Value="{DynamicResource Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Accent">
                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Red">
                <Setter Property="Foreground" Value="{DynamicResource Red}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tone}" Value="Green">
                <Setter Property="Foreground" Value="{DynamicResource Green}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ChipTemplate">
        <c:Pill Style="{StaticResource ChipBorder}">
            <TextBlock Text="{Binding Text}" Style="{StaticResource ChipText}" />
        </c:Pill>
    </DataTemplate>

    <!-- Card outline from CardViewModel.Edge. -->
    <Style x:Key="CardFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Glass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Edge}" Value="Amber">
                <Setter Property="BorderBrush" Value="{DynamicResource AmberEdge}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Edge}" Value="Red">
                <Setter Property="BorderBrush" Value="{DynamicResource RedEdge}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A card with no state edge (Send tab). -->
    <Style x:Key="PlainCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Glass}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!-- Status dot from the session group. -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Session.Group}" Value="Working">
                <Setter Property="Fill" Value="{DynamicResource Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Session.Group}" Value="Waiting">
                <Setter Property="Fill" Value="{DynamicResource Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Session.NeedsApproval}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource RedDot}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Send state line colour. -->
    <Style x:Key="SendState" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SendTone}" Value="Pending">
                <Setter Property="Foreground" Value="{DynamicResource Amber}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SendTone}" Value="Delivered">
                <Setter Property="Foreground" Value="{DynamicResource Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding SendTone}" Value="Failed">
                <Setter Property="Foreground" Value="{DynamicResource Red}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Focus ring: 2 px accent outline. -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <c:Pill BorderThickness="2" BorderBrush="{DynamicResource Accent}" Margin="-2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 36 px round outline icon button (header). -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" CornerRadius="18" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill buttons: primary is accent-fill, Outline is glass + line-strong with an accent hover. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:Pill x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </c:Pill>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SmallPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource SmallPrimaryButton}">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <c:Pill x:Name="b" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </c:Pill>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Footer button: 30 px, 12 px text. -->
    <Style x:Key="FooterButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    </Style>

    <!-- Text-only link button ("Send anyway"). -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet text button: muted 12 px, accent on hover ("Dismiss" on a waiting item). -->
    <Style x:Key="QuietLinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The accent link at 12 px ("Undo" on a dismissed item). -->
    <Style x:Key="SmallLinkButton" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,1">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 30 px accent pill (one waiting item's own Send). -->
    <Style x:Key="TinyPrimaryButton" TargetType="Button" BasedOn="{StaticResource SmallPrimaryButton}">
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Segment in a pill track (tabs, filter chips). The checked one is accent-fill with white text. -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Text2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <c:Pill x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </c:Pill>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TabSegment" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="6,4" />
    </Style>

    <Style x:Key="PillTrack" TargetType="Border">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Background" Value="{DynamicResource Glass}" />
    </Style>

    <!-- Plain text input on a field; the frame is drawn by the parent. -->
    <Style x:Key="BareTextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slim scroll bar: 6 px thumb in line-strong, no arrows. -->
    <Style x:Key="SlimThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border CornerRadius="3" Background="{DynamicResource LineStrong}" Margin="1,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb Style="{StaticResource SlimThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Menus (the settings menu). -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                            CornerRadius="10" Padding="4">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" CornerRadius="8" Padding="10,7" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="16" Height="16" Margin="0,0,10,0" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource LineStrong}">
                                <c:Glyph x:Name="check" Size="12" Data="{StaticResource Icon.Check}" Visibility="Collapsed"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Session picker (Send tab). -->
    <Style x:Key="PickerToggle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Picker" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="frame" CornerRadius="12" Background="{DynamicResource Surface}" BorderThickness="1"
                                BorderBrush="{DynamicResource Line}" MinHeight="44" Padding="12,0,10,0">
                            <DockPanel>
                                <c:Glyph DockPanel.Dock="Right" Size="14" Data="{StaticResource Icon.ChevronDown}"
                                         Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center" IsHitTestVisible="False" />
                            </DockPanel>
                        </Border>
                        <ToggleButton Style="{StaticResource PickerToggle}" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="None">
                            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                    CornerRadius="10" Padding="4" Margin="0,4,0,0" MaxHeight="300"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="b" CornerRadius="8" Padding="10,7" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        "Answered" or "Dismissed" tag of a waiting item (DataContext: AnswerItemViewModel); collapsed for an
        open item. Answered is green, dismissed is grey. The tooltip says what the tag means.
    -->
    <DataTemplate x:Key="StateTagTemplate">
        <Border x:Name="tag" CornerRadius="999" Padding="7,0,7,1" BorderThickness="1" Background="{DynamicResource Surface2}"
                BorderBrush="{DynamicResource Line}" ToolTip="{Binding TagToolTip}" ToolTipService.InitialShowDelay="300"
                Visibility="{Binding TagText, Converter={StaticResource EmptyToCollapsed}}">
            <TextBlock x:Name="label" Text="{Binding TagText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                <Setter TargetName="tag" Property="Background" Value="{DynamicResource GreenSoft}" />
                <Setter TargetName="tag" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="label" Property="Foreground" Value="{DynamicResource Green}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--
        One "Waiting on you" item (DataContext: AnswerItemViewModel): the id in bold amber, then the text;
        sub-items under it. An answered or dismissed item is muted and carries its tag after the id.
    -->
    <DataTemplate x:Key="WaitingItemTemplate">
        <StackPanel Margin="0,2">
            <TextBlock x:Name="line" TextWrapping="Wrap">
                <Run x:Name="id" Text="{Binding Id, Mode=OneWay, StringFormat='{}{0} ', TargetNullValue=''}" FontWeight="Bold" Foreground="{DynamicResource Amber}" /><InlineUIContainer BaselineAlignment="Center"><ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource StateTagTemplate}" Margin="0,0,6,0" Visibility="{Binding TagText, Converter={StaticResource EmptyToCollapsed}}" /></InlineUIContainer><Run Text="{Binding Text, Mode=OneWay}" />
            </TextBlock>
            <ItemsControl x:Name="children" ItemsSource="{Binding Children}" Margin="14,0,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource Text2}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSettled}" Value="True">
                <Setter TargetName="line" Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter TargetName="id" Property="Foreground" Value="{DynamicResource Muted}" />
                <Setter TargetName="children" Property="Opacity" Value="0.7" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A message bubble: yours on the right in accent-soft, the session's on the left in surface-2. -->
    <DataTemplate x:Key="ExchangeTemplate">
        <Border x:Name="bubble" CornerRadius="12" Padding="10,8" Margin="0,4" HorizontalAlignment="Left"
                Background="{DynamicResource Surface2}" MaxWidth="320">
            <StackPanel>
                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="160" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding FromOwner}" Value="True">
                <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="bubble" Property="Background" Value="{DynamicResource AccentSoft}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
    <!-- An ItemsControl that scrolls (the virtualizing panel needs the ScrollViewer around its presenter). -->
    <ControlTemplate x:Key="ScrollingList" TargetType="ItemsControl">
        <ScrollViewer Focusable="False" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="{TemplateBinding Padding}">
            <ItemsPresenter />
        </ScrollViewer>
    </ControlTemplate>

    <!-- Home card: what waits on you in one session. Approvals only offer Jump (they stay in the terminal). -->
    <DataTemplate x:Key="HomeCardTemplate">
        <Border Style="{StaticResource CardFrame}">
            <StackPanel>
                <Button Command="t:PanelCommands.Focus" CommandParameter="{Binding}" Cursor="Hand" Foreground="{DynamicResource Text}"
                        AutomationProperties.Name="{Binding Session.Name}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <DockPanel>
                        <c:Glyph DockPanel.Dock="Right" Data="{StaticResource Icon.ChevronRight}" Size="16" Foreground="{DynamicResource Muted}"
                                 VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StateDot}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Session.Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       MaxWidth="230" Margin="0,0,10,0" />
                            <ContentPresenter Content="{Binding ProfileChip}" ContentTemplate="{StaticResource ChipTemplate}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DockPanel>
                </Button>
                <StackPanel Visibility="{Binding Session.NeedsApproval, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0"
                               Text="A permission prompt is open in its terminal. Approve it there." />
                    <Button Style="{StaticResource SmallPrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Command="t:PanelCommands.Jump" CommandParameter="{Binding}">
                        <StackPanel Orientation="Horizontal">
                            <c:Glyph Data="{StaticResource Icon.ShieldCheck}" Size="15" Margin="0,0,7,0" />
                            <TextBlock Text="Jump to approve" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Answers.Items}" ItemTemplate="{StaticResource WaitingItemTemplate}" Margin="0,8,0,0"
                              Visibility="{Binding HasWaiting, Converter={StaticResource Visible}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Window (design 2) ===== -->

    <!-- Title-bar caption button (minimize, maximize): 46 x 40. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close turns red on hover, like the system caption. -->
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Detail tab with an accent underline (Status / History / Send). -->
    <Style x:Key="UnderlineTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="b" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                            <Setter Property="Foreground" Value="{DynamicResource Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A status box of the window. -->
    <Style x:Key="StatusBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,2,14,12" />
    </Style>

    <!-- The "Waiting on you" box gets the amber edge while questions are open. DataContext: CardViewModel. -->
    <Style x:Key="WaitingBox" TargetType="Border" BasedOn="{StaticResource StatusBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasOpenWaiting}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AmberEdge}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Bubble of the window's "Last exchange": wider than the panel's, at most 92 % of the list. -->
    <DataTemplate x:Key="WideExchangeTemplate">
        <Border x:Name="bubble" CornerRadius="12" Padding="10,8" Margin="0,4" HorizontalAlignment="Left"
                Background="{DynamicResource Surface2}"
                MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Fraction}, ConverterParameter=0.92}">
            <StackPanel>
                <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,2" />
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="240" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding FromOwner}" Value="True">
                <Setter TargetName="bubble" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="bubble" Property="Background" Value="{DynamicResource AccentSoft}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Dot of the link state (title pill, status bar). DataContext: PanelViewModel. -->
    <Style x:Key="LinkDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Muted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Link}" Value="Live">
                <Setter Property="Fill" Value="{DynamicResource Green}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Link}" Value="Reconnecting">
                <Setter Property="Fill" Value="{DynamicResource RedDot}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LinkPill" TargetType="c:Pill">
        <Setter Property="Padding" Value="8,1,10,1" />
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Link}" Value="Live">
                <Setter Property="Background" Value="{DynamicResource GreenSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Link}" Value="Reconnecting">
                <Setter Property="Background" Value="{DynamicResource RedSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Banner under the title (daemon stopped, link lost). DataContext: PanelViewModel. -->
    <Style x:Key="LinkBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding BannerIsError}" Value="True">
                <Setter Property="Background" Value="{DynamicResource RedSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RedSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
