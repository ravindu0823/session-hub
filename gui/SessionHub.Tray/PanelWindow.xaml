<Window x:Class="SessionHub.Tray.PanelWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:SessionHub.Tray.Controls"
        xmlns:t="clr-namespace:SessionHub.Tray"
        Title="Session Hub" Width="436" Height="792"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
    <!-- Design 1 of the spec (§3.3, §9). The outer 16 px margin holds the shadow; the panel itself is 404 px wide. -->
    <Grid x:Name="Frame" Margin="16">
        <Border CornerRadius="14" Background="{DynamicResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="36" ShadowDepth="10" Direction="270" Opacity="0.45" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
        </Border>
        <Border x:Name="Root" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                Background="{DynamicResource PanelBackground}" RenderTransformOrigin="0.5,1">
            <Border.RenderTransform>
                <TranslateTransform x:Name="Rise" />
            </Border.RenderTransform>
            <Grid>
                <Border CornerRadius="14" Background="{DynamicResource PanelGlow}" IsHitTestVisible="False" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: app tile, title, link pill, settings / open window / close. -->
                    <Grid Margin="16,16,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="12" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF8A63" />
                                    <GradientStop Offset="1" Color="#E0501F" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <c:Glyph Data="{StaticResource Icon.Terminal}" Size="22" Foreground="White"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Session Hub" FontSize="19" FontWeight="Bold" />
                            <c:Pill x:Name="LinkPill" Padding="8,1,10,1" Margin="0,4,0,0" HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="LinkDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LinkText}" FontSize="12" FontWeight="Medium" />
                                </StackPanel>
                            </c:Pill>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="0,0,8,0" ToolTip="Settings"
                                    AutomationProperties.Name="Settings" Click="OnSettings">
                                <c:Glyph Data="{StaticResource Icon.Settings}" Size="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Margin="0,0,8,0" ToolTip="Open full window"
                                    AutomationProperties.Name="Open full window" Click="OnOpenWindow">
                                <c:Glyph Data="{StaticResource Icon.Monitor}" Size="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" ToolTip="Close (Esc)" AutomationProperties.Name="Close"
                                    Click="OnClose">
                                <c:Glyph Data="{StaticResource Icon.X}" Size="16" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Banner: daemon stopped (with Start daemon) or link lost. -->
                    <Border x:Name="Banner" Grid.Row="1" Margin="12,0,12,8" CornerRadius="10" Padding="10,8" BorderThickness="1"
                            Visibility="{Binding ShowBanner, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:Glyph x:Name="BannerIcon" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding BannerText}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource SmallPrimaryButton}" Margin="8,0,0,0" Content="Start daemon"
                                    Visibility="{Binding CanStartDaemon, Converter={StaticResource Visible}}" Click="OnStartDaemon" />
                        </Grid>
                    </Border>

                    <!-- Tabs in one pill track. -->
                    <c:Pill Grid.Row="2" Style="{StaticResource PillTrack}" Margin="14,0,14,10">
                        <c:FlexRow>
                            <RadioButton x:Name="TabHome" Style="{StaticResource TabSegment}" GroupName="tabs" Checked="OnTab" Tag="Home"
                                         AutomationProperties.Name="Home">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.House}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Home" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabSessions" Style="{StaticResource TabSegment}" GroupName="tabs" Checked="OnTab" Tag="Sessions"
                                         AutomationProperties.Name="Sessions">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Bot}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Sessions" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabWaiting" Style="{StaticResource TabSegment}" GroupName="tabs" Checked="OnTab" Tag="Waiting"
                                         AutomationProperties.Name="Waiting">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Inbox}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Waiting" />
                                    <Border x:Name="WaitingBadge" CornerRadius="9" MinWidth="18" Height="18" Padding="6,0" Margin="7,0,0,0"
                                            Visibility="Collapsed">
                                        <TextBlock x:Name="WaitingCount" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="TabSend" Style="{StaticResource TabSegment}" GroupName="tabs" Checked="OnTab" Tag="Send"
                                         AutomationProperties.Name="Send">
                                <StackPanel Orientation="Horizontal">
                                    <c:Glyph Data="{StaticResource Icon.Send}" Size="16" Margin="0,0,7,0" />
                                    <TextBlock Text="Send" />
                                </StackPanel>
                            </RadioButton>
                        </c:FlexRow>
                    </c:Pill>

                    <TextBlock Grid.Row="3" Margin="16,0,16,10" Foreground="{DynamicResource Text2}" Text="{Binding Lede}" TextWrapping="Wrap" />

                    <!-- Search (Sessions, Waiting). -->
                    <Border x:Name="SearchFrame" Grid.Row="4" Margin="14,0,14,8" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Line}"
                            Background="{DynamicResource Glass}" Padding="12,0"
                            Visibility="{Binding ShowSearch, Converter={StaticResource Visible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:Glyph Data="{StaticResource Icon.Search}" Size="16" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search sessions, folders or question ids"
                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBox x:Name="Search" Grid.Column="1" Style="{StaticResource BareTextBox}" Padding="0,10"
                                     AutomationProperties.Name="Search"
                                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnSearchChanged" />
                        </Grid>
                    </Border>

                    <!-- Filter chips (Sessions). -->
                    <c:Pill Grid.Row="5" Style="{StaticResource PillTrack}" Margin="14,0,14,4" HorizontalAlignment="Left"
                            Visibility="{Binding ShowFilters, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FilterAll" Style="{StaticResource Segment}" GroupName="filters" Content="All" Tag="All" Checked="OnFilter" />
                            <RadioButton x:Name="FilterWaiting" Style="{StaticResource Segment}" GroupName="filters" Content="Waiting" Tag="Waiting" Checked="OnFilter" />
                            <RadioButton x:Name="FilterWorking" Style="{StaticResource Segment}" GroupName="filters" Content="Working" Tag="Working" Checked="OnFilter" />
                            <RadioButton x:Name="FilterIdle" Style="{StaticResource Segment}" GroupName="filters" Content="Idle" Tag="Idle" Checked="OnFilter" />
                            <RadioButton x:Name="FilterEnded" Style="{StaticResource Segment}" GroupName="filters" Content="Ended" Tag="Ended" Checked="OnFilter" />
                        </StackPanel>
                    </c:Pill>

                    <TextBlock Grid.Row="6" Margin="16,4,16,8" FontSize="12" Foreground="{DynamicResource Muted}" Text="{Binding Summary}"
                               Visibility="{Binding Summary, Converter={StaticResource EmptyToCollapsed}}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Lists. -->
                    <Grid Grid.Row="7">
                        <ItemsControl x:Name="HomeList" ItemsSource="{Binding Items}" Margin="10,0,10,10"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                      ItemTemplate="{StaticResource HomeCardTemplate}" Template="{StaticResource ScrollingList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <ItemsControl x:Name="CardList" ItemsSource="{Binding Items}" Margin="10,0,10,10"
                                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                                      Template="{StaticResource ScrollingList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <c:SessionCard />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Send tab: picker, reply box, info-only note. -->
                        <ScrollViewer x:Name="SendPane" Margin="10,0,10,10" VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsSendTab, Converter={StaticResource Visible}}">
                            <Border Style="{StaticResource PlainCard}" DataContext="{Binding SendTarget}" VerticalAlignment="Top"
                                    Visibility="{Binding Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="Send to" />
                                    <ComboBox x:Name="Picker" Style="{StaticResource Picker}" Margin="0,6,0,10"
                                              AutomationProperties.Name="Send to"
                                              ItemsSource="{Binding DataContext.SendTargets, ElementName=Frame}"
                                              SelectedItem="{Binding DataContext.SendTarget, ElementName=Frame}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Session.Name, Mode=OneWay}" />
                                                    <Run Text="{Binding ProfileChip.Text, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource Muted}" />
                                                    <Run Text="{Binding StatusChip.Text, Mode=OneWay, StringFormat='· {0}'}" Foreground="{DynamicResource Muted}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <c:SendBox x:Name="SendTabBox" Visibility="{Binding Answers.IsActive, Converter={StaticResource Hidden}}" />
                                    <c:AnswerForm x:Name="SendTabAnswers" Compact="True" Visibility="{Binding Answers.IsActive, Converter={StaticResource Visible}}" />
                                    <TextBlock Style="{StaticResource Note}" Margin="0,10,0,0"
                                               Text="Info-only messages. Approvals still happen in the session's own terminal." />
                                </StackPanel>
                            </Border>
                        </ScrollViewer>

                        <!-- Empty state: dashed line-strong card with a green check tile. -->
                        <Grid VerticalAlignment="Top" Margin="14,2,14,0" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                            <Rectangle RadiusX="14" RadiusY="14" Fill="{DynamicResource Glass}" Stroke="{DynamicResource LineStrong}"
                                       StrokeThickness="1" StrokeDashArray="4 3" />
                            <StackPanel HorizontalAlignment="Center" Margin="24,36">
                                <Border Width="48" Height="48" CornerRadius="16" Background="{DynamicResource GreenSoft}" HorizontalAlignment="Center">
                                    <c:Glyph Data="{StaticResource Icon.CircleCheck}" Size="24" Foreground="{DynamicResource Green}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,6" />
                                <TextBlock Text="{Binding EmptyText}" Foreground="{DynamicResource Text2}" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="300" />
                            </StackPanel>
                        </Grid>

                        <!-- Short notice (Jump failed, daemon did not start). -->
                        <Border x:Name="Notice" VerticalAlignment="Bottom" Margin="14,0,14,12" CornerRadius="12" Padding="12,10"
                                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <!-- Footer: a save warning when drafts cannot be written, then day and age, key hints, Quit. -->
                    <StackPanel Grid.Row="8">
                    <TextBlock Margin="16,8,12,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Red}"
                               Text="{Binding FooterWarning}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding FooterWarning, Converter={StaticResource EmptyToCollapsed}}" />
                    <TextBlock Margin="16,8,12,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Red}"
                               Text="{Binding RelayStrayText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelayStrayText}"
                               Visibility="{Binding RelayStrayText, Converter={StaticResource EmptyToCollapsed}}" />
                    <Grid Margin="16,8,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding FooterText}" FontSize="12" Foreground="{DynamicResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Esc · Ctrl+1–4 · Ctrl+F" FontSize="12" Foreground="{DynamicResource Muted}"
                                   Margin="12,0" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Style="{StaticResource FooterButton}" Click="OnQuit" AutomationProperties.Name="Quit">
                            <StackPanel Orientation="Horizontal">
                                <c:Glyph Data="{StaticResource Icon.Power}" Size="14" Margin="0,0,6,0" />
                                <TextBlock Text="Quit" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
